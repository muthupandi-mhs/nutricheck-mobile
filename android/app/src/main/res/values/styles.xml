<resources>

    <!--
      Fixed dark, not DayNight. The app has one palette and it is dark, so
      following the system would leave a phone in light mode painting a white
      window for the frames before React mounts, and rendering system widgets
      — selection handles, dialogs, the keyboard — light against a dark app.
    -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
        <item name="android:windowBackground">@color/canvas</item>
    </style>

</resources>
